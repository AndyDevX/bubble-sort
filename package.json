  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capgo/capacitor-updater": "8.53.1",
    "phaser": "^4.2.1"
  }
}
